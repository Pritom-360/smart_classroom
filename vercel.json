{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/competition.html",
      "destination": "/competition/",
      "permanent": true
    },
    {
      "source": "/reset-password",
      "destination": "/competition/#/reset-password",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/competition/:path*",
      "destination": "/competition/index.html"
    }
  ]
}
